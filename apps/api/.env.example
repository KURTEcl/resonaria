APP_NAME=Resonaria
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8017

FRONTEND_URL=http://127.0.0.1:3017

# Token de Google Search Console (archivo /google{token}.html y meta).
# GOOGLE_SITE_VERIFICATION=
# En producción: directorio htdocs para reescribir sitemap/robots/llms al publicar.
# DISCOVERY_PUBLIC_PATH=
# Archivos estáticos del front (portadas en public/casos/{slug}/cover.webp).
# WEB_PUBLIC_PATH=../web/public

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=resonaria

PORTAL_NAME=Resonaria
PORTAL_TAGLINE=What changes. Who is affected.
PORTAL_DESCRIPTION=A source-driven publication portal.
PORTAL_LOCALE=es
PORTAL_HTML_LANG=es-CL
PORTAL_EDITORIAL_TONE=clear-formal
PORTAL_CONTENT_TYPES=tracking,news,analysis,opinion
PORTAL_GITHUB_URL=https://github.com/kurtecl/resonaria
PORTAL_SUPPORT_URL=https://ko-fi.com/kurtecl
PORTAL_SOCIAL_INSTAGRAM=
PORTAL_SOCIAL_X=
PORTAL_AGENT_EMAIL=agent@portal.local
DB_USERNAME=root
# Si la clave tiene : o #, usa comillas: DB_PASSWORD="mi:clave"
DB_PASSWORD=

SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=database

# Secreto largo para abrir la mesa: /cuaderno?c=ESTE_VALOR
DESK_GATE=

# Inspección temporal de redes (MCP inspect_social_post)
# Local: brew install yt-dlp ffmpeg whisper.cpp
# Luego: php artisan social:whisper-model && php artisan social:inspect-doctor
# WHISPER_BIN=whisper-cli
# WHISPER_MODEL=base
# WHISPER_MODEL_PATH=
# OPENAI_API_KEY=
# YTDLP_BIN=yt-dlp
# FFMPEG_BIN=ffmpeg
# SOCIAL_INSPECT_MAX_SECONDS=180
# YTDLP_COOKIES_FILE=
