# Copiar a deploy/secrets.env (no commitear). Usado por scripts/deploy.sh y scripts/db-*.sh

# SSH
PROD_SSH=queperdimos@45.228.210.14
PROD_APP_PATH=/home/queperdimos/queperdimos
# Document root CloudPanel (Nuxt estático tras npm run generate)
PROD_WEB_PATH=/home/queperdimos/htdocs/queperdimos.cl

# MySQL en el servidor (desde el host, la API usa 127.0.0.1)
PROD_DB_HOST=127.0.0.1
PROD_DB_PORT=3306
PROD_DB_NAME=queperdimoscl
PROD_DB_USER=queperdimoscl
PROD_DB_PASSWORD=

# URL pública (sin barra final)
PROD_APP_URL=https://resonaria.cl
PROD_API_URL=https://resonaria.cl/api

# Mesa de contenido (apps/api/.env en el servidor, no en el front)
# DESK_GATE=  → la URL es /cuaderno?c=DESK_GATE
# Crear la cuenta: php artisan desk:user tu@correo --password='...'
