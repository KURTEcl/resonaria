# Resonaria — root env (copy to .env; never commit .env)

APP_NAME=Resonaria
APP_ENV=local
APP_DEBUG=true

# Puertos locales (dev-start.sh — evitan chocar con 8000/3000 de otros proyectos)
API_PORT=8017
WEB_PORT=3017

# Laravel API (alinear APP_URL en apps/api/.env con API_PORT)
API_URL=http://127.0.0.1:8017
APP_URL=http://127.0.0.1:3017

# Base de datos (MySQL local — ver apps/api/.env)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=queperdimos
DB_USERNAME=root
DB_PASSWORD=

# Redis (colas, caché)
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Integración IA / MCP (opcional)
MCP_ENABLED=false
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# Inspección de redes: brew install yt-dlp ffmpeg whisper.cpp && cd apps/api && php artisan social:whisper-model && php artisan social:inspect-doctor
# YTDLP_BIN=yt-dlp
# FFMPEG_BIN=ffmpeg
# SOCIAL_INSPECT_MAX_SECONDS=180
# YTDLP_COOKIES_FILE=

# Nuxt público
# Opcional: dev-start.sh exporta esto al arrancar Nuxt según API_PORT
NUXT_PUBLIC_API_BASE=http://127.0.0.1:8017/api
NUXT_PUBLIC_PORTAL_NAME=Resonaria
NUXT_PUBLIC_PORTAL_TAGLINE=What changes. Who is affected.
NUXT_PUBLIC_PORTAL_DESCRIPTION=A source-driven publication portal.
NUXT_PUBLIC_PORTAL_GITHUB_URL=https://github.com/kurtecl/resonaria
NUXT_PUBLIC_PORTAL_SUPPORT_URL=https://ko-fi.com/kurtecl
NUXT_PUBLIC_PORTAL_SOCIAL_INSTAGRAM=
NUXT_PUBLIC_PORTAL_SOCIAL_X=
NUXT_PUBLIC_SITE_LANG=es-CL
NUXT_PUBLIC_GA_MEASUREMENT_ID=
