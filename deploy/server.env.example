# Plantilla para apps/api/.env en el servidor (copiar manualmente la primera vez).
# No commitear el archivo real en el servidor con claves de producción en git.

APP_NAME=Resonaria
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://resonaria.cl

FRONTEND_URL=https://resonaria.cl

# Token HTML de Search Console (sin el prefijo google ni .html).
GOOGLE_SITE_VERIFICATION=
DISCOVERY_PUBLIC_PATH=/home/queperdimos/htdocs/queperdimos.cl

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=queperdimoscl
DB_USERNAME=queperdimoscl
DB_PASSWORD=

SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=database

LOG_CHANNEL=stack
LOG_LEVEL=warning
